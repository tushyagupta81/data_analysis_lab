   "source": [
    "4.Create a function to sort 2d Array by a column."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "46157ff4",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "eef45925",
   "metadata": {},
   "outputs": [],
   "source": [
    "def sort_col(x, col: int):\n",
    "    return x[x[:, col].argsort()]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6b7cb973",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[[29 45 90 78]\n",
      " [21  3 55 48]\n",
      " [54 38 66 59]]\n",
      "[[21  3 55 48]\n",
      " [54 38 66 59]\n",
      " [29 45 90 78]]\n"
     ]
    }
   ],
   "source": [
    "arr = np.random.randint(0, 100, (3, 4))\n",
    "print(arr)\n",
    "print(sort_col(arr, 1))"
   ]
  }
