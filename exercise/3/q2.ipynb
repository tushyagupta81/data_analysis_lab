   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[1. 2. 3. 5. 6. 7.]\n"
     ]
    }
   ],
   "source": [
    "arr = np.array([1, 2, 3, np.nan, 5, 6, 7, np.nan])\n",
    "arr = arr[~np.isnan(arr)]\n",
    "print(arr)"
   ]
  }
